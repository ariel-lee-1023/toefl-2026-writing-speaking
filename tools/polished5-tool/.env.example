# Copy this file to .env and fill in your own values.
# This tool commits archived responses into YOUR OWN fork of the
# toefl-2026-writing-speaking repo (or any repo with a matching folder
# layout) — it does not write to the original author's repo.

# Required: Anthropic API key used to classify + reformat pasted transcripts.
ANTHROPIC_API_KEY=sk-ant-...

# Required: which repo to commit archived files into.
# Example: if your fork lives at https://github.com/your-username/toefl-2026-writing-speaking
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=toefl-2026-writing-speaking

# Optional: branch to commit to (defaults to "main" if unset).
GITHUB_REPO_BRANCH=main

# Optional: root folder inside the repo where archived responses live
# (defaults to "polished-5-5-responses" if unset — only change this if
# you renamed the folder in your fork).
ARCHIVE_ROOT_FOLDER=polished-5-5-responses
